# EduAI PS52 Backend Environment Configuration
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Security & Tokens
SECRET_KEY=eduai_super_secret_jwt_key_ps52_academic_system
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default; can be postgresql://user:pass@host:5432/dbname)
